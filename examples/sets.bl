# We want to assume everything is a set. A scalar value is just
# a special case of a set with 1 item in it.  Maybe we should implicitly
# cast single items to a "list" and "null" to an empty list.  Maybe null never
# exists, we just have an empty set

# if we reason about everything as sets we should be able to do a LINQ type thing

const Person = struct:
  name: string
  age: int 
  parent: Person

var people = {}

var siblings = select *
  from people
  join people on parent = parent
